# Frontend telemetry execution mode: demo or live. No provider credentials belong here.
NEXT_PUBLIC_MONITORING_MODE=demo
# Same-origin backend proxy path only. Do not put tokens in this URL.
NEXT_PUBLIC_MONITORING_API_BASE_URL=/api/v1/monitoring

# Assessment engine defaults to deterministic evidence-based rules. To enrich
# explanations with a self-hosted OpenAI-compatible provider, configure all
# three values on the server only; never expose the key as NEXT_PUBLIC_*.
ASSESSMENT_AI_PROVIDER=rules
ASSESSMENT_AI_PROVIDER_URL=
ASSESSMENT_AI_PROVIDER_KEY=
